<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ElevatorSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система контроля лифта" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и статус -->
        <Border Grid.Row="0" Background="#FF0078D7" Padding="10">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Система контроля лифта" 
                           Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="StatusText" Text="Статус: Ожидание" 
                           Foreground="White" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MainContentGrid" Margin="20">
                <!-- Содержимое создается динамически -->
            </Grid>
        </ScrollViewer>

        <!-- Панель управления -->
        <Border Grid.Row="2" Background="#FFF0F0F0" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="StartButton" Content="Старт симуляции" 
                        Width="120" Height="35" Margin="5" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="Стоп" 
                        Width="80" Height="35" Margin="5" Click="StopButton_Click" IsEnabled="False"/>
                <Button x:Name="PauseButton" Content="Пауза" 
                        Width="80" Height="35" Margin="5" Click="PauseButton_Click" IsEnabled="False"/>
                <Button x:Name="CreatePersonButton" Content="Создать человека" 
                        Width="120" Height="35" Margin="5" Click="CreatePersonButton_Click"
                        Background="#FF28A745" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Информационная панель -->
        <Border Grid.Row="3" Background="#FFE8E8E8" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Текущий этаж:" FontWeight="Bold"/>
                    <TextBlock x:Name="CurrentFloorText" Text="-" FontSize="16"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Состояние:" FontWeight="Bold"/>
                    <TextBlock x:Name="ElevatorStateText" Text="Ожидание" FontSize="16"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Вес в лифте:" FontWeight="Bold"/>
                    <TextBlock x:Name="WeightText" Text="0 кг" FontSize="16"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Людей в системе:" FontWeight="Bold"/>
                    <TextBlock x:Name="PeopleCountText" Text="0" FontSize="16"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>