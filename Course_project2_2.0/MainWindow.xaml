<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ElevatorSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система контроля лифта" 
        Height="750" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и статус -->
        <Border Grid.Row="0" Background="#FF0078D7" Padding="10">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Система контроля лифта" 
                           Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="StatusText" Text="Статус: Ожидание" 
                           Foreground="White" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="MainContentGrid" Margin="10">
                <!-- Содержимое создается динамически -->
            </Grid>
        </ScrollViewer>

        <!-- Панель управления -->
        <Border Grid.Row="2" Background="#FFF0F0F0" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="StartButton" Content="Старт симуляции" 
                        Width="120" Height="35" Margin="5" Click="StartButton_Click"
                        Background="#FF28A745" Foreground="White" FontWeight="Bold"/>
                <Button x:Name="StopButton" Content="Стоп" 
                        Width="80" Height="35" Margin="5" Click="StopButton_Click"
                        Background="#FFDC3545" Foreground="White" FontWeight="Bold"
                        IsEnabled="False"/>
                <Button x:Name="CreatePersonButton" Content="Создать человека" 
                        Width="120" Height="35" Margin="5" Click="CreatePersonButton_Click"
                        Background="#FF0078D7" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Информационная панель -->
        <Border Grid.Row="3" Background="#FFE8E8E8" Padding="10" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Текущий этаж:" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="CurrentFloorText" Text="-" FontSize="20" FontWeight="Bold" Foreground="#0078D7"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Вес в лифте:" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="WeightText" Text="0 кг" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Индикатор перегрузки -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Перегрузка:" FontWeight="Bold" FontSize="12"/>
                    <Border x:Name="OverloadIndicator" 
                            Width="40" 
                            Height="40" 
                            CornerRadius="20" 
                            Background="LightGray" 
                            BorderThickness="2" 
                            BorderBrush="DarkGray"
                            Margin="0,5,0,0">
                        <TextBlock Text="!" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="OverloadText" Text="Нет" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="Время работы:" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="ElapsedTimeText" Text="00:00" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="Перевезено людей:" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="TransportedCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#28A745"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>