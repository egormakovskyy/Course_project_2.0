<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ElevatorSim.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приложение лифт"
        Height="250"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid Background="#FF0078D7">
        <Border Background="White"
                Margin="30"
                CornerRadius="10"
                BorderThickness="2"
                BorderBrush="#FF0056B3">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="Система симуляции лифта"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FF0078D7"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Нажмите Enter  чтобы продолжить"
                           FontSize="16"
                           Foreground="#333333"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>