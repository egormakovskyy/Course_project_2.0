<?xml version="1.0" encoding="windows-1251"?>
<Window x:Class="ElevatorSim.CreatePersonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание нового человека" 
        Height="350" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0" Text="Создание нового человека" 
                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Текущий этаж:" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="CurrentFloorComboBox" Width="100" 
                      VerticalAlignment="Center" SelectedIndex="0"/>
        </StackPanel>


        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Целевой этаж:" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="TargetFloorComboBox" Width="100" 
                      VerticalAlignment="Center" SelectedIndex="1"/>
        </StackPanel>


        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,20">
            <Label Content="Вес (кг):" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="WeightTextBox" Width="100" VerticalAlignment="Center" 
                     Text="70" TextAlignment="Right"/>
            <TextBlock Text="кг" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="CreateButton" Content="Создать" 
                    Width="100" Height="30" Margin="10" Click="CreateButton_Click"
                    Background="#FF0078D7" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="CancelButton" Content="Отмена" 
                    Width="100" Height="30" Margin="10" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>