<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ElevatorSim.InitializationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Инициализация системы" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Секция 1: Параметры здания и лифта -->
        <GroupBox Grid.Row="0" Header="Параметры здания и лифта" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Количество этажей -->
                <Label Grid.Column="0" Grid.Row="0" Content="Количество этажей (n):" 
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="FloorsTextBox" Grid.Column="1" Grid.Row="0" 
                         Width="100" HorizontalAlignment="Left" Margin="0,0,0,0" Text="10"/>

                <!-- Стартовый этаж лифта -->
                <Label Grid.Column="2" Grid.Row="0" Content="Стартовый этаж лифта:" 
                       VerticalAlignment="Center" Margin="20,0,10,0"/>
                <TextBox x:Name="StartFloorTextBox" Grid.Column="3" Grid.Row="0" 
                         Width="100" HorizontalAlignment="Left" Margin="0,0,0,0" Text="1"/>
            </Grid>
        </GroupBox>

        <!-- Секция 2: Список людей -->
        <GroupBox Grid.Row="1" Header="Люди (вне лифта) - опционально" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Кнопки управления списком людей -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Button x:Name="AddPersonButton" Content="+ Добавить человека" 
                            Click="AddPersonButton_Click" Margin="0,0,10,0" Padding="10,5"/>
                    <Button x:Name="RemovePersonButton" Content="− Удалить выбранного" 
                            Click="RemovePersonButton_Click" Padding="10,5"/>
                </StackPanel>

                <!-- Таблица людей -->
                <DataGrid x:Name="PeopleDataGrid" Grid.Row="1" AutoGenerateColumns="False" 
                          CanUserAddRows="False" SelectionMode="Single"
                          CanUserDeleteRows="False" CanUserReorderColumns="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Вес (кг)" Binding="{Binding Weight}" Width="100"/>
                        <DataGridTextColumn Header="Текущий этаж" Binding="{Binding CurrentFloor}" Width="120"/>
                        <DataGridTextColumn Header="Этаж назначения" Binding="{Binding TargetFloor}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="#FFF0F0F0" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- УДЛИНЕНА кнопка -->
                <Button x:Name="InitializeButton" Content="Инициализировать систему" 
                        Width="200" Height="35" Margin="10" Click="InitializeButton_Click" 
                        FontSize="14" FontWeight="Bold" Background="#FF0078D7" Foreground="White"/>
                <Button x:Name="CancelButton" Content="Отмена" 
                        Width="100" Height="35" Margin="10" Click="CancelButton_Click"
                        FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>