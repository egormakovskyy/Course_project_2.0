<?xml version="1.0" encoding="windows-1251"?>
<Window x:Class="ElevatorSim.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчет о симуляции" 
        Height="500" 
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FF0078D7" Padding="15" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="ОТЧЕТ О СИМУЛЯЦИИ" 
                           Foreground="White" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Результаты работы системы" 
                           Foreground="White" FontSize="16" 
                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Статистика -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" 
                Margin="0,20,0,20" Padding="20" Background="#FAFAFA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Общее количество поездок -->
                <Border Grid.Row="0" Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,1" 
                        Padding="15" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Общее количество поездок" 
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TotalTripsText" Text="0" 
                                   FontSize="24" Foreground="#0078D7"/>
                    </StackPanel>
                </Border>

                <!-- Холостые поездки -->
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" 
                        Padding="15" Margin="10,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Холостые поездки" 
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock x:Name="EmptyTripsText" Text="0" 
                                   FontSize="24" Foreground="#28A745"/>
                    </StackPanel>
                </Border>

                <!-- Суммарный перемещенный вес -->
                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,1" 
                        Padding="15" Margin="0,10,10,10">
                    <StackPanel>
                        <TextBlock Text="Суммарный перемещенный вес" 
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TotalWeightText" Text="0 кг" 
                                   FontSize="24" Foreground="#FFC107"/>
                    </StackPanel>
                </Border>

                <!-- Количество созданных людей -->
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" 
                        Padding="15" Margin="10,10,0,10">
                    <StackPanel>
                        <TextBlock Text="Создано людей" 
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TotalPeopleText" Text="0" 
                                   FontSize="24" Foreground="#DC3545"/>
                    </StackPanel>
                </Border>

                <!-- Эффективность -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                        BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" 
                        Padding="15" Margin="0,10,0,10" Background="#F8F9FA">
                    <StackPanel>
                        <TextBlock Text="Эффективность системы" 
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock x:Name="EfficiencyText" Text="0%" 
                                   FontSize="24"/>
                    </StackPanel>
                </Border>

                <!-- Дополнительная информация -->
                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                        Padding="15" Margin="0,10,0,0" Background="#E8F4FD">
                    <TextBlock x:Name="AdditionalInfoText" TextWrapping="Wrap" FontSize="12">
                        <Run Text="Примечание: "/>
                        <Run Text="• Под поездкой понимается изменение направления движения"/>
                        <LineBreak/>
                        <Run Text="• Холостая поездка - лифт двигался без пассажиров"/>
                        <LineBreak/>
                        <Run Text="• Вес считается только для доставленных людей"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ExitButton" Content="Выйти из приложения" 
                    Width="150" Height="35" Margin="10" Background="#DC3545" Foreground="White"
                    Click="ExitButton_Click"/>
            <Button x:Name="NewSimulationButton" Content="Начать новую симуляцию" 
                    Width="180" Height="35" Margin="10" Background="#28A745" Foreground="White"
                    Click="NewSimulationButton_Click"/>
        </StackPanel>
    </Grid>
</Window>